#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        toggle-gaming {
            bindings = <&tog 5>;
            key-positions = <11 2 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // home-row mods and layer-tap thumbs

        base {
            display-name = "base";
            bindings = <
&kp Q        &kp W        &kp E         &kp R         &kp T        &kp Y        &kp U            &kp I         &kp O        &kp P
&hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G        &kp H        &hmr RCTRL J     &hmr RSHFT K  &hmr RALT L  &hmr RGUI SEMICOLON
&kp Z        &kp X        &kp C         &kp V         &kp B        &kp N        &kp M            &kp COMMA     &kp DOT      &kp SLASH
                                        &lt 1 SPACE   &lt 2 TAB    &lt 3 ENTER  &lt 4 BACKSPACE
            >;
        };

        navigation {
            display-name = "navigation";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &kp INS     &mkp MB4  &mkp MB5   &kp K_CONTEXT_MENU  &trans
&trans  &trans  &trans  &trans  &trans    &caps_word  &kp LEFT  &kp RIGHT  &kp UP              &kp DOWN
&trans  &trans  &trans  &trans  &trans    &kp CLCK    &kp HOME  &kp END    &kp PG_UP           &kp PAGE_DOWN
                        &trans  &trans    &kp ESC     &kp DEL
            >;
        };

        media_numbers {
            display-name = "media and numbers";
            bindings = <
&trans  &kp K_PREV  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp C_VOL_UP    &trans  &kp N7  &kp N8  &kp N9  &kp N0
&trans  &trans      &trans            &trans      &kp C_VOL_DN    &trans  &kp N4  &kp N5  &kp N6  &kp BSLH
&trans  &trans      &trans            &kp K_STOP  &kp K_MUTE      &trans  &kp N1  &kp N2  &kp N3  &kp SINGLE_QUOTE
                                      &trans      &trans          &trans  &trans
            >;
        };

        function_keys {
            display-name = "function keys";
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &trans  &trans  &trans  &trans
&trans  &kp F4  &kp F5  &kp F6  &kp F11    &trans  &trans  &trans  &trans  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F12    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans     &trans  &trans
            >;
        };

        symbols_brackets {
            display-name = "symbols and brackets";
            bindings = <
&trans  &kp GRAVE        &kp MINUS  &kp EQUAL  &trans    &trans  &trans  &trans  &trans  &trans
&kp LT  &kp LEFT_BRACE   &kp LBKT   &kp LPAR   &trans    &trans  &trans  &trans  &trans  &trans
&kp GT  &kp RIGHT_BRACE  &kp RBKT   &kp RPAR   &trans    &trans  &trans  &trans  &trans  &trans
                                    &trans     &trans    &trans  &trans
            >;
        };

        game {
            display-name = "game";
            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp E      &kp R      &trans  &trans  &trans  &trans  &kp ESC
&kp LSHFT  &kp A  &kp S  &kp D      &kp F      &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp Z  &kp X  &kp C      &kp V      &trans  &trans  &trans  &trans  &trans
                         &kp SPACE  &kp TAB    &trans  &trans
            >;
        };
    };
};
